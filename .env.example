# Hosted providers are optional. Engram can run with Ollama only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

ENGRAM_DATABASE_URL=postgresql://engram:engram@localhost:5439/engram
ENGRAM_PROVIDER=ollama
ENGRAM_MODEL=olmo-3:7b-instruct
ENGRAM_OLLAMA_URL=http://localhost:11434
ENGRAM_EMBEDDING_MODEL=nomic-embed-text:v1.5
ENGRAM_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ENGRAM_OPENAI_ECONOMY_MODEL=gpt-5.6-luna
ENGRAM_OPENAI_BALANCED_MODEL=gpt-5.6-terra
ENGRAM_OPENAI_FRONTIER_MODEL=gpt-6-astra
